#: includes/class-permissions.php:53
#: includes/class-permissions.php:365
msgid "WP-Cron & Action Scheduler"
msgstr ""

#: includes/admin/views/tab-docs.php:199
msgid "Inspection of registered WP-Cron schedules, intervals, overdue jobs, and Action Scheduler queues (in-progress, failed, pending actions with error failure logs)."
msgstr ""

