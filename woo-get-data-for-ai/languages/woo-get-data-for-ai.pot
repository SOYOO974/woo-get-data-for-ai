msgid "System & Limits"
msgstr ""

#: includes/admin/views/tab-docs.php:169
msgid "Dynamic capabilities discovery catalog, ready-to-use SKILL.md generator (?format=skill), WordPress, PHP, MySQL versions, memory limits, active plugins with update status, database health with autoload footprint analysis, transactional SMTP mail diagnostic, security hardening audit, HPOS state, and Action Scheduler queues."
msgstr ""

#: includes/admin/views/tab-docs.php:172
msgid "WooCommerce & Themes"
msgstr ""

#: includes/admin/views/tab-docs.php:174
msgid "Overridden WooCommerce templates with version check against core, Woodmart & Elessi theme settings, child theme functions.php and style.css."
msgstr ""

#: includes/admin/views/tab-docs.php:177
msgid "Code & Plugins"
msgstr ""

#: includes/admin/views/tab-docs.php:179
msgid "File trees of plugins and mu-plugins (supports ?status=active|inactive|all), sandboxed reading of specific PHP, JS, or CSS files with strict path validation."
msgstr ""

