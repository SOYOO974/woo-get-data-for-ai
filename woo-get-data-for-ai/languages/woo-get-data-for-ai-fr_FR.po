#: woo-get-data-for-ai.php:6
msgid "WP Agent Bridge (Data for AI)"
msgstr "WP Agent Bridge (Données pour IA)"

#: woo-get-data-for-ai.php:7
msgid "Enterprise-grade, read-only inspection API for WordPress & WooCommerce. Securely exposes system state, logs, Elementor trees, WPCode snippets, and theme options to AI agents (Antigravity, Claude, Cursor)."
msgstr "API d'inspection en lecture seule pour WordPress et WooCommerce. Expose de manière sécurisée l'état système, les logs, les arbres Elementor, les snippets WPCode et les réglages de thèmes aux agents IA (Antigravity, Claude, Cursor)."

#: includes/class-security.php:63
msgid "Only GET (Read-Only) requests are permitted by WP Agent Bridge."
msgstr "Seules les requêtes GET (Lecture seule) sont autorisées par WP Agent Bridge."

#: includes/class-security.php:73
msgid "No Agent Bridge token configured on this server."
msgstr "Aucun token Agent Bridge configuré sur ce serveur."

#: includes/class-security.php:94
msgid "Missing or invalid Authorization Bearer header."
msgstr "En-tête Authorization Bearer manquant ou invalide."

#: includes/class-security.php:104
msgid "Invalid authentication token."
msgstr "Token d'authentification invalide."

#: includes/class-security.php:118
msgid "Access denied: Client IP is not in the authorized whitelist."
msgstr "Accès refusé : L'adresse IP cliente n'est pas dans la liste blanche autorisée."

#: includes/class-security.php:131
msgid "Too many requests. Please throttle your queries (limit: 120/min)."
msgstr "Trop de requêtes. Veuillez ralentir vos appels (limite : 120/min)."

#: includes/class-permissions.php:17
msgid "System & Environment"
msgstr "Système & Environnement"

#: includes/class-permissions.php:18
msgid "Allows inspection of WP, PHP, MySQL versions, active plugins list, server limits, and Action Scheduler crons."
msgstr "Permet l'inspection des versions WP, PHP, MySQL, des extensions actives, des limites serveur et de l'Action Scheduler."

#: includes/class-permissions.php:23
msgid "WooCommerce Diagnostic & Overrides"
msgstr "Diagnostic WooCommerce & Surcharges"

#: includes/class-permissions.php:24
msgid "Allows auditing template overrides in active themes, detecting outdated WooCommerce templates, and HPOS status."
msgstr "Permet d'auditer les templates WooCommerce surchargés dans le thème actif, de détecter les versions obsolètes et le statut HPOS."

#: includes/class-permissions.php:29
msgid "Theme Settings & Child Theme"
msgstr "Réglages Thème & Thème Enfant"

#: includes/class-permissions.php:30
msgid "Allows exporting Woodmart (xts-woodmart-options), Elessi (elessi_options) settings, and child theme functions.php/style.css."
msgstr "Permet d'exporter les options Woodmart (xts-woodmart-options), Elessi (elessi_options) et le code du thème enfant."

#: includes/class-permissions.php:35
msgid "Code & Plugin File Inspector"
msgstr "Inspecteur de Code & Extensions"

#: includes/class-permissions.php:36
msgid "Allows browsing active plugins and mu-plugins file structures and reading specific PHP/JS/CSS files in sandbox."
msgstr "Permet de parcourir les fichiers des extensions actives/mu-plugins et de lire des fichiers PHP/JS/CSS sous sandbox."

#: includes/class-permissions.php:41
msgid "Elementor Architecture"
msgstr "Architecture Elementor"

#: includes/class-permissions.php:42
msgid "Allows reading Elementor page trees, global kit styles, and mapping form widgets with webhooks."
msgstr "Permet de lire les arbres JSON Elementor, les styles globaux du kit et de cartographier les formulaires et webhooks."

#: includes/class-permissions.php:47
msgid "WPCode Snippets"
msgstr "Extraits de Code WPCode"

#: includes/class-permissions.php:48
msgid "Allows listing and inspecting custom PHP, JS, and CSS snippets stored in WPCode plugin."
msgstr "Permet de lister et d'inspecter les extraits de code personnalisés PHP, JS et CSS stockés dans WPCode."

#: includes/class-permissions.php:53
msgid "Error & WooCommerce Logs"
msgstr "Journaux d'Erreurs & Logs WooCommerce"

#: includes/class-permissions.php:54
msgid "Allows listing and tail-reading debug.log and uploads/wc-logs/*.log with memory protection."
msgstr "Permet de lister et d'extraire les dernières lignes de debug.log et wc-logs avec protection mémoire."

